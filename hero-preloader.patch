@@ -0,0 +1,38 @@
+/* =========================================================
+   PRELOADER
+
+   Fully transparent, full-viewport overlay. There is no logo,
+   progress bar or copy here on purpose — the fixed SiteBackdrop
+   "hero" canvas (z-index 0) is already visible and animating
+   directly underneath this element, so that scene IS the loading
+   screen. This file only exists to fade the overlay itself out
+   (releasing scroll/pointer capture) and to visually hide the
+   screen-reader-only status text.
+   ========================================================= */
+
+.preloader {
+  position: fixed;
+  inset: 0;
+  z-index: 200;
+
+  background: transparent;
+
+  transition: opacity 0.9s ease;
+}
+
+.preloader.is-closing {
+  opacity: 0;
+  pointer-events: none;
+}
+
+.preloader-sr-status {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  padding: 0;
+  margin: -1px;
+  overflow: hidden;
+  clip: rect(0, 0, 0, 0);
+  white-space: nowrap;
+  border: 0;
+}
