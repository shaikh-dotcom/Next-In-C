 .site-backdrop-hero {
   opacity: 1;
+
+  /* full-bleed by default; .is-splash below clips this down to a
+     centered window for the loading screen */
+  clip-path: inset(0 round 0px);
+  transition:
+    opacity 0.8s ease,
+    clip-path 1.1s cubic-bezier(0.65, 0, 0.35, 1);
 }
 .site-backdrop.is-hero-off .site-backdrop-hero {
   opacity: 0;
 }
+
+/*
+ * SPLASH WINDOW
+ * While the site is loading, the hero layer is clipped to a
+ * centered, rounded box instead of filling the page — a dedicated
+ * splash visual rather than a background peeking through. --splash-half
+ * is half the box's side length, capped so it never gets silly-huge
+ * on a wide monitor or overflows a small phone screen.
+ * Percentages in clip-path: inset() resolve against the element's own
+ * box (which is the full 100vw x 100vh backdrop), so this centers
+ * correctly on both axes without any JS measuring.
+ */
+.site-backdrop.is-splash .site-backdrop-hero {
+  --splash-half: min(220px, 34vw, 34vh);
+  clip-path: inset(
+    calc(50% - var(--splash-half)) calc(50% - var(--splash-half))
+      calc(50% - var(--splash-half)) calc(50% - var(--splash-half))
+      round 28px
+  );
+}
+
 .site-backdrop-ambient {
   opacity: 0;
 }
@@ -42,8 +70,55 @@
   opacity: 1;
 }
 
+@media (prefers-reduced-motion: reduce) {
+  .site-backdrop-hero {
+    transition: opacity 0.4s ease;
+  }
+}
+
 /* sections must stack above the fixed backdrop */
 main > section {
   position: relative;
   z-index: 1;
 }
+
+/*
+ * Everything except the backdrop and the Preloader lives in here.
+ * It mounts and loads immediately (so images/fonts/etc. are ready
+ * in the background) but stays invisible until App's `siteReady`
+ * flips true, at which point it eases in over the already-running
+ * hero canvas instead of popping in.
+ */
+.site-content {
+  position: relative;
+  z-index: 1;
+
+  /* opacity only — deliberately no transform/filter here. Either one
+     would create a new containing block, which breaks Navbar's
+     `position: fixed` for the duration of the transition. visibility
+     keeps hidden links/buttons out of the tab order and off the
+     pointer while the Preloader is up, without ever unmounting the
+     page (so it can keep loading behind it). */
+  opacity: 0;
+  visibility: hidden;
+  transition:
+    opacity 0.9s ease,
+    visibility 0s linear 0.9s;
+}
+
+.site-content.is-revealed {
+  opacity: 1;
+  visibility: visible;
+  transition: opacity 0.9s ease;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .site-content {
+    transition:
+      opacity 0.4s ease,
+      visibility 0s linear 0.4s;
+  }
+  .site-content.is-revealed {
+    transition: opacity 0.4s ease;
+  }
+}
