+++ b/src/components/Preloader.jsx
@@ -0,0 +1,60 @@
+import { useEffect, useState } from "react";
+import "./Preloader.css";
+
+const EXIT_MS = 900;
+
+/*
+ * PRELOADER
+ *
+ * No logo, no progress bar — the loading screen IS the hero WebGL
+ * animation. This overlay is fully transparent and sits above the
+ * rest of the page, but the fixed SiteBackdrop "hero" canvas
+ * underneath it is already mounted and running, so what the visitor
+ * watches while the site loads is the same knot/streams scene
+ * building up (uIntro ramping in HeroBackdrop.jsx) that then simply
+ * stays put as the Hero section's background. There is nothing to
+ * cross-fade on the canvas side — only the rest of the page (Navbar,
+ * copy, other sections) fades in on top of it once ready.
+ *
+ * All this component does: block interaction/scroll with the hidden
+ * page while loading, announce progress to screen readers (there's
+ * nothing to see, but there should be something to hear), and
+ * unmount cleanly once `ready` flips true.
+ */
+export default function Preloader({ ready }) {
+  const [unmounted, setUnmounted] = useState(false);
+
+  useEffect(() => {
+    if (!ready) return undefined;
+    const t = setTimeout(() => setUnmounted(true), EXIT_MS);
+    return () => clearTimeout(t);
+  }, [ready]);
+
+  // Lock scroll while the loader owns the screen; release it the
+  // moment the close transition starts so the reveal feels immediate.
+  useEffect(() => {
+    if (ready) {
+      document.body.style.overflow = "";
+      return undefined;
+    }
+    document.body.style.overflow = "hidden";
+    return () => {
+      document.body.style.overflow = "";
+    };
+  }, [ready]);
+
+  if (unmounted) return null;
+
+  return (
+    <div
+      className={`preloader${ready ? " is-closing" : ""}`}
+      role="status"
+      aria-live="polite"
+      aria-busy={!ready}
+    >
+      <span className="preloader-sr-status">
+        {ready ? "Content loaded." : "Loading Next Inc."}
+      </span>
+    </div>
+  );
+}
